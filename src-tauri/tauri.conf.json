{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Re-track",
  "version": "0.1.0",
  "identifier": "dev.magomin.retrack",
  "build": {
    "frontendDist": "../panel"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Re-track",
        "width": 460,
        "height": 460,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
